{
  "name": "server",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#knip-config": "./knip.config.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx scripts/seed.ts",
    "convert-food-composition": "tsx scripts/convert-food-composition.ts",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "drizzle-kit": "0.31.10",
    "read-excel-file": "9.3.10",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@fohte/service-kit": "0.1.16",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@sentry/node": "10.58.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.12.34",
    "neverthrow": "8.2.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  }
}
