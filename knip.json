{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "entry": [
    "scripts/convert-food-composition.ts!",
    "scripts/seed.ts!",
    "src/db/migrate.ts!",
    "src/index.ts!"
  ],
  "project": [
    "src/**/*.ts!",
    "scripts/**/*.ts!",
    "!src/**/*.test.ts!",
    "!src/**/test-helpers.ts!",
    "!src/test/**!",
    "!scripts/**/*.test.ts!"
  ],
  "ignoreDependencies": ["@commitlint/cli"],
  "ignore": ["commitlint-plugin-no-external-refs.cjs"]
}
