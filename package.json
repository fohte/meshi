{
  "name": "meshi",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "build": "tsup",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx scripts/seed.ts",
    "convert-food-composition": "tsx scripts/convert-food-composition.ts",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@eslint/eslintrc": "3.3.6",
    "@fohte/eslint-config": "0.4.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.1.2",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.6.0",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-tailwindcss": "4.2.0",
    "prettier": "3.9.6",
    "read-excel-file": "9.3.10",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@fohte/service-kit": "0.1.13",
    "@hono/node-server": "2.0.12",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.13",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/openai": "1.5.10",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@sentry/node": "10.58.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "langchain": "1.5.10",
    "neverthrow": "8.2.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  }
}
